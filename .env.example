# PostgreSQL connection string. Create a database before running migrations.
DATABASE_URL="postgresql://postgres:password@localhost:5432/zoomhub60?schema=public"

# Add these only when implementing Zoom OAuth. Keep secrets server-side.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:3000/api/zoom/callback"

# Generate a strong random 32-byte key and store it securely.
# Used by the backend to encrypt the centrally stored meeting password.
APP_ENCRYPTION_KEY=""
