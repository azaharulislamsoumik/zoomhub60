generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  NOT_CONNECTED
  CONNECTED
  TOKEN_EXPIRED
  ERROR
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String         @db.Text
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  oauthStates  OAuthState[]
  activityLogs ActivityLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model ZoomAccount {
  id              String        @id @default(cuid())
  slotNumber      Int           @unique
  displayName     String
  zoomUserId      String?       @unique
  email           String?
  status          AccountStatus @default(NOT_CONNECTED)
  accessTokenEnc  String?       @db.Text
  refreshTokenEnc String?       @db.Text
  tokenExpiresAt  DateTime?
  activityLogs    ActivityLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  oauthStates     OAuthState[]

  @@index([status])
}

model MeetingConfiguration {
  id                 String   @id @default("primary")
  meetingLink        String?
  meetingId          String?
  meetingPasswordEnc String?  @db.Text
  updatedAt          DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  adminId     String?
  accountId   String?
  description String?
  createdAt   DateTime @default(now())

  admin   AdminUser?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  account ZoomAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([accountId])
  @@index([adminId])
}

model OAuthState {
  id        String   @id @default(cuid())
  stateHash String   @unique @db.VarChar(64)
  adminId   String
  accountId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin   AdminUser   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  account ZoomAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([accountId])
}
